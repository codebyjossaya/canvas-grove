{
  "manifest_version": 3,
  "name": "Grove for Canvas",
  "version": "0.1.0",
  "description": "Opens Canvas links from Canvas Grove already signed in, so LTI tools and New Quizzes work in your own browser.",
  "permissions": ["cookies", "storage", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "Grove for Canvas", "default_popup": "options.html" }
}
