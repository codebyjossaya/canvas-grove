# PostgreSQL connection string. Use a pooled runtime URL in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/canvas_grove

# Clerk values are supplied by the Clerk CLI or hosting provider.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Self-hosted isolated Chromium is the production default.
HOSTED_BROWSER_PROVIDER=self-hosted
BROWSER_ORCHESTRATOR_URL=
BROWSER_ORCHESTRATOR_SECRET=
BROWSER_RELAY_CONTROL_SECRET=
BROWSER_EGRESS_REGISTRATION_SECRET=
BROWSER_PUBLIC_BASE_URL=
BROWSER_IDLE_TTL_SECONDS=1800
SYNC_WORKER_CONCURRENCY=4
SYNC_WORKER_POLL_MS=3000

# Optional Browserbase provider.

# Base64-encoded 32-byte key-encryption key and its rotation identifier.
BROWSER_STATE_KEK=
BROWSER_STATE_KEK_ID=

# Optional manual fallback only; Docker production does not use Browserbase.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_ALLOWED_AUTH_DOMAINS=
BROWSERBASE_SESSION_TIMEOUT_SECONDS=21600

# Fully self-hosted Docker Compose. Generate private values with
# `node scripts/bootstrap-self-hosted.mjs`; do not reuse these blanks.
APP_PORT=3000
LAN_PORT=3000
BROWSER_PUBLIC_PORT=8080
BROWSER_PUBLIC_BASE_URL=http://localhost:8080
POSTGRES_DB=canvas_grove
POSTGRES_ADMIN_USER=canvas_grove_admin
POSTGRES_ADMIN_PASSWORD=
APP_DATABASE_USER=canvas_grove_app
APP_DATABASE_PASSWORD=
BROWSER_ORCHESTRATOR_URL=http://browser-orchestrator:8080
BROWSER_ORCHESTRATOR_SECRET=
BROWSER_RELAY_CONTROL_SECRET=
BROWSER_EGRESS_REGISTRATION_SECRET=
BROWSER_IDLE_TTL_SECONDS=1800
